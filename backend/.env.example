# Puerto del API
PORT=3311
# Secreto JWT - CAMBIAR EN PRODUCCIÓN
JWT_SECRET=cambia-esto-en-produccion

# Cómo hablar con CUPS:
#   local = comandos lpstat/lp ejecutados en esta máquina (producción, dentro de printserver)
#   ssh   = los mismos comandos via ssh (desarrollo desde la PC del admin)
CUPS_MODE=ssh
SSH_ALIAS=cups-server

# Argumento extra para lpstat/lp/cancel (vacío en prod; en dev apunta a la instancia de pruebas)
# Ejemplo dev: -h localhost:6320
CUPS_TARGET=

# Ruta del conf de impresoras (solo lectura)
PRINTERS_CONF=/etc/cups/printers.conf
# Directorio de spool de CUPS (solo lectura)
SPOOL_DIR=/var/spool/cups

# SQLite y uploads
DB_PATH=./data/tecnoprint.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
# Modo demo: datos ficticios sin CUPS real (para probar el portal sin infraestructura)
DEMO=false
